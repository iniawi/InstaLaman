# Ambil dari Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=ey...anon-key-kamu

# JANGAN pernah taruh ini di kode client / commit ke GitHub secara publik
SUPABASE_SERVICE_ROLE_KEY=ey...service-role-key-kamu

# Ambil dari aistudio.google.com > Get API key (gratis)
GEMINI_API_KEY=AIza...

# Opsional: ganti model kalau default tidak tersedia / kena limit
# GEMINI_MODEL=gemini-2.5-flash

# Domain utama kamu (tanpa https://). Dipakai untuk subdomain usaha: namausaha.domainmu
# Produksi: instalaman.id   |   Lokal: localhost:3000  (tes di http://namausaha.localhost:3000)
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000

# ===== Midtrans (pembayaran langganan) =====
# Midtrans Dashboard > Settings > Access Keys. Pakai SANDBOX dulu untuk tes.
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxx
# true kalau sudah pakai key produksi
MIDTRANS_IS_PRODUCTION=false
# Daftarkan di Midtrans > Settings > Configuration > Payment Notification URL:
#   https://DOMAINMU/api/midtrans/notify
